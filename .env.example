# Supabase  (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Cloudinary ไม่ต้องใส่ที่นี่ — ตั้งเป็น Supabase secrets แล้ว deploy Edge Functions (ดู README)

# URL ของเว็บ (ใช้ทำ sitemap / OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (ไม่บังคับ) — ปกติใส่รหัส G-XXXXXXXXXX ที่ระบบจัดการเว็บไซต์ > ตั้งค่าเว็บไซต์ > SEO แทน
# ค่านี้เป็นแค่ค่าสำรองถ้าในฐานข้อมูลว่าง (เว้นว่างได้)
NEXT_PUBLIC_GA_ID=

# Supabase  (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Cloudinary ไม่ต้องใส่ที่นี่ — ตั้งเป็น Supabase secrets แล้ว deploy Edge Functions (ดู README)

# URL ของเว็บ (ใช้ทำ sitemap / OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (ไม่บังคับ) — Measurement ID จาก analytics.google.com > Admin > Data Streams
# เว้นว่างไว้ = ไม่โหลดสคริปต์ GA (สถิติในระบบจัดการเว็บไซต์ยังทำงานตามปกติ ไม่ต้องพึ่ง GA)
NEXT_PUBLIC_GA_ID=
